---
interface Props {
  href: string;
  art?: 'voll' | 'rand' | 'khaki';
  class?: string;
  /** Alles Weitere (download, target, rel, aria-*) wird an das <a> durchgereicht. */
  [key: string]: unknown;
}
const { href, art = 'voll', class: klasse = '', ...rest } = Astro.props;

const stile = {
  voll: 'bg-ocker text-braun hover:bg-ocker-hell',
  rand: 'border border-khaki text-khaki-hell hover:bg-khaki hover:text-beige',
  khaki: 'bg-khaki text-beige hover:bg-khaki-tief',
};
---

<a
  href={href}
  {...rest}
  class:list={[
    'inline-block px-8 py-3 text-label font-semibold uppercase transition-colors duration-200',
    stile[art],
    klasse,
  ]}>
  <slot />
</a>
