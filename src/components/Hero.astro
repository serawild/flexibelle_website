---
import Wortmarke from './Wortmarke.astro';
import Signet from './Signet.astro';
import Knopf from './Knopf.astro';
import { heroBild, heroBildHoch } from '../config';

const links = [
  { href: '#band', text: 'Band' },
  { href: '#musik', text: 'Musik' },
  { href: '#live', text: 'Live' },
  { href: '#booking', text: 'Booking' },
];
---

<section id="oben" class="relative isolate flex min-h-svh flex-col bg-braun text-beige">
  {heroBild && (
    <picture>
      {heroBildHoch && (
        <source media="(orientation: portrait) and (max-width: 640px)" srcset={heroBildHoch} />
      )}
      <img
        src={heroBild}
        alt=""
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-10 h-full w-full object-cover
          object-[center_38%] max-sm:portrait:object-[center_45%]" />
    </picture>
  )}

  {/* Verlauf: oben für die Navigation, unten für die Schrift */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-braun/85 via-braun/55 to-braun/90"></div>

  <!-- Navigation im Kopf -->
  <nav
    class="relative z-10 mx-auto flex w-full max-w-inhalt flex-col items-center gap-3 px-6 py-6
      sm:flex-row sm:justify-between sm:gap-0 sm:px-10"
    aria-label="Hauptnavigation">
    <a href="#oben" class="transition-opacity hover:opacity-80">
      <Wortmarke klein />
      <span class="sr-only">flexiBelle — zum Seitenanfang</span>
    </a>
    <ul class="flex flex-wrap justify-center gap-5 sm:gap-8">
      {links.map((l) => (
        <li>
          <a href={l.href}
            class="text-label font-medium uppercase text-beige/75 transition-colors hover:text-ocker">
            {l.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Die Marke: sitzt im unteren Drittel, damit sie die Köpfe im Bild nicht verdeckt -->
  <div class="relative z-10 flex flex-1 flex-col items-center justify-end px-6 pb-16 pt-24
    text-center sm:pb-20">
    <Signet groesse={72} class="mb-56 sm:mb-8" />
    <h1><Wortmarke /><span class="sr-only">flexiBelle</span></h1>
    <p class="mt-5 text-subline uppercase text-taupe-hell">Live Musik · Eigeni Songs</p>
    <p class="mx-auto mt-8 max-w-text font-zitat text-claim italic text-ocker">
      Es Trio — und je nach Song eis meh
    </p>
    <Knopf href="#booking" class="mt-10">Anfrage senden</Knopf>
  </div>
</section>
