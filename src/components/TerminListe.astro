---
import termine from '../data/termine.json';

const heute = new Date().toISOString().slice(0, 10);
const sorted = [...termine].sort((a, b) => a.datum.localeCompare(b.datum));
const kommend = sorted.filter((t) => t.datum >= heute);
const vergangen = sorted.filter((t) => t.datum < heute).reverse();
---

{kommend.length === 0 ? (
  <p class="mt-8 max-w-text text-taupe">
    Im Moment isch kein Uftritt usgschriebe. Für e Aafrag schriib eus — mir
    spieled gärn.
  </p>
) : (
  <ul class="mt-10 border-t border-sand">
    {kommend.map((t) => (
      <li class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-sand py-4">
        <time datetime={t.datum} class="w-full text-label font-bold text-ocker-text sm:w-32 sm:shrink-0">
          {t.anzeige}
        </time>
        <span class="font-semibold">{t.ort}</span>
        {t.gast && <span class="font-zitat italic text-khaki-tief">{t.gast}</span>}
        {t.zeit && <span class="ml-auto whitespace-nowrap text-taupe">{t.zeit}</span>}
      </li>
    ))}
  </ul>
)}

{vergangen.length > 0 && (
  <div class="mt-12">
    <p class="text-label font-semibold uppercase text-taupe">Vergangeni Gigs</p>
    <ul class="mt-4 border-t border-sand/60">
      {vergangen.map((t) => (
        <li class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-sand/60 py-3 text-taupe">
          <time datetime={t.datum} class="w-full text-label sm:w-32 sm:shrink-0">
            {t.anzeige}
          </time>
          <span>{t.ort}</span>
          {t.gast && <span class="font-zitat italic">{t.gast}</span>}
        </li>
      ))}
    </ul>
  </div>
)}
