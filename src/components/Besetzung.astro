---
import besetzung from '../data/besetzung.json';
---

<ul class="mt-12 flex flex-wrap items-start gap-x-6 gap-y-8 sm:gap-12">
  {besetzung.map((m) => (
    <li class="w-24 text-center sm:w-28">
      <div class="mx-auto h-20 w-20 rounded-full bg-sand sm:h-28 sm:w-28"></div>
      <p class="mt-4 text-[0.6875rem] font-semibold uppercase leading-tight
        tracking-[0.1em] text-taupe">{m.instrument}</p>
    </li>
  ))}

  <li class="self-center pt-2 text-4xl font-semibold text-khaki" aria-hidden="true">+</li>

  <li class="w-24 text-center sm:w-28">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full border
      border-dashed border-khaki font-marke text-3xl text-khaki-tief sm:h-28 sm:w-28">?</div>
    <p class="mt-4 text-[0.6875rem] font-semibold uppercase leading-tight
      tracking-[0.1em] text-khaki-tief">wechselt</p>
  </li>
</ul>
