---
import besetzung from '../data/besetzung.json';
---

<ul class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
  {besetzung.map((m) => (
    <li>
      <div class="h-40 w-40 overflow-hidden rounded-full bg-sand">
        {m.bild && <img src={m.bild} alt={m.name} class="h-full w-full object-cover" />}
      </div>
      <h3 class="titel mt-6 text-untertitel">{m.name}</h3>
      {m.instrument && (
        <p class="mt-1 text-label font-semibold uppercase text-ocker-text">{m.instrument}</p>
      )}
      {m.text && <p class="mt-3 max-w-sm">{m.text}</p>}
    </li>
  ))}

  <!-- Der offene vierte Platz: das Konzept der Band -->
  <li>
    <div class="flex h-40 w-40 items-center justify-center rounded-full border border-dashed
      border-khaki font-marke text-5xl text-khaki-tief">?</div>
    <h3 class="titel mt-6 text-untertitel text-khaki-tief">+1</h3>
    <p class="mt-1 text-label font-semibold uppercase text-khaki-tief">wechselnd</p>
    <p class="mt-3 max-w-sm text-taupe">
      Für einzelne Songs holen wir jemanden dazu. Wer das ist, entscheidet der Abend.
    </p>
  </li>
</ul>
