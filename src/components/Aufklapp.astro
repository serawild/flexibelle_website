---
/**
 * Aufklappbarer Kasten für lange Abschnitte.
 *
 * Baut auf <details>/<summary> auf: kommt ohne JavaScript aus, ist mit der
 * Tastatur bedienbar, die Browsersuche öffnet einen Treffer von selbst, und
 * beim Ausdrucken der Seite ist der Inhalt sichtbar.
 *
 * `farbe` steuert nur die Akzentfarbe der Beschriftung und des Pfeils —
 * ocker für die eigene Anlage und den Preis, khaki für die Anlage vor Ort
 * und den Ablauf. Damit bleibt die bisherige Zuordnung der beiden Varianten
 * erhalten.
 */
interface Props {
  /** Kleine Beschriftung über dem Titel, z. B. «Variante 1». Optional. */
  label?: string;
  titel: string;
  farbe?: 'ocker' | 'khaki';
  /** Beim Laden bereits offen. */
  offen?: boolean;
}
const { label, titel, farbe = 'ocker', offen = false } = Astro.props;

const akzent = farbe === 'ocker' ? 'text-ocker' : 'text-khaki-hell';
---

<details class="group" open={offen}>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 py-5
      [&::-webkit-details-marker]:hidden">
    <span>
      {label && <span class:list={['label block', akzent]}>{label}</span>}
      <span class:list={['titel text-untertitel', label && 'mt-2 block']}>{titel}</span>
    </span>
    <svg
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
      aria-hidden="true"
      class:list={[
        'h-6 w-6 shrink-0 transition-transform duration-200 group-open:rotate-180',
        akzent,
      ]}>
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </summary>

  <div class="pb-6">
    <slot />
  </div>
</details>
