---
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { istLive } from '../config';

interface Props {
  titel: string;
  beschreibung: string;
}
const { titel, beschreibung } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {!istLive && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#231A12" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:image" content={new URL('/og-flexibelle.png', kanonisch).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Signet von flexiBelle" />

    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50
        focus:bg-ocker focus:px-4 focus:py-2 focus:text-label focus:uppercase focus:text-braun">
      Zum Inhalt springen
    </a>
    <Kopf />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />

    <!-- Hintergrundmusik: ein Element für die ganze Seite, gesteuert von den
         Ton-Schaltern in Hero und mitlaufender Leiste. preload="none", damit
         die 1.7 MB erst geladen werden, wenn jemand sie hören will. -->
    <audio id="hintergrundmusik" src="/audio/gheimnis.m4a" preload="none" loop></audio>

    <script>
      const klang = document.getElementById('hintergrundmusik') as HTMLAudioElement | null;
      const schalter = document.querySelectorAll<HTMLButtonElement>('[data-ton-schalter]');

      if (klang && schalter.length) {
        const SCHLUESSEL = 'flexibelle-ton';

        function zeigen(laeuft: boolean) {
          for (const knopf of schalter) {
            knopf.setAttribute('aria-pressed', String(laeuft));
            knopf.setAttribute('aria-label', laeuft ? 'Musik anhalten' : 'Musik abspielen');
            knopf.querySelector('[data-ton-aus]')?.classList.toggle('hidden', laeuft);
            knopf.querySelector('[data-ton-an]')?.classList.toggle('hidden', !laeuft);
          }
        }

        for (const knopf of schalter) {
          knopf.addEventListener('click', () => {
            if (klang.paused) {
              klang.play().catch(() => zeigen(false));
            } else {
              klang.pause();
            }
          });
        }

        klang.addEventListener('play', () => {
          zeigen(true);
          sessionStorage.setItem(SCHLUESSEL, 'an');
        });
        klang.addEventListener('pause', () => {
          zeigen(false);
          sessionStorage.setItem(SCHLUESSEL, 'aus');
        });
        // Stand über Impressum und Datenschutz hinweg merken.
        klang.addEventListener('timeupdate', () => {
          sessionStorage.setItem(SCHLUESSEL + '-stelle', String(klang.currentTime));
        });

        if (sessionStorage.getItem(SCHLUESSEL) === 'an') {
          const stelle = Number(sessionStorage.getItem(SCHLUESSEL + '-stelle') ?? 0);
          if (stelle > 0) klang.currentTime = stelle;
          // Kann der Browser ablehnen — dann bleibt der Knopf einfach auf «aus».
          klang.play().catch(() => zeigen(false));
        }

        // Ton anhalten, wenn eine Hörprobe gestartet wird — sonst spielt beides.
        for (const spieler of document.querySelectorAll('video')) {
          spieler.addEventListener('play', () => klang.pause());
        }
      }
    </script>
  </body>
</html>
