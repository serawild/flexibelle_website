---
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { istLive } from '../config';
import tailwind from '../../tailwind.config';

/**
 * `theme-color` färbt die Browserleiste auf dem Handy. Ein Meta-Tag nimmt
 * keine Tailwind-Klasse, deshalb holen wir den Wert direkt aus den Tokens —
 * so steht der Hex-Wert weiterhin nur in `tailwind.config.ts` (Regel 1).
 */
const braun = tailwind.theme!.extend!.colors!.braun as string;

interface Props {
  titel: string;
  beschreibung: string;
}
const { titel, beschreibung } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {!istLive && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={braun} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:image" content={new URL('/og-flexibelle.png', kanonisch).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Signet von flexiBelle" />

    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50
        focus:bg-ocker focus:px-4 focus:py-2 focus:text-label focus:uppercase focus:text-braun">
      Zum Inhalt springen
    </a>
    <Kopf />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />

    <!-- Hintergrundmusik: ein Element für die ganze Seite, gesteuert von den
         Ton-Schaltern in Hero und mitlaufender Leiste. preload="none", damit
         die 1.7 MB erst geladen werden, wenn jemand sie hören will. -->
    <audio id="hintergrundmusik" src="/audio/gheimnis.m4a" preload="none"></audio>

    <script>
      const klang = document.getElementById('hintergrundmusik') as HTMLAudioElement | null;
      const schalter = document.querySelectorAll<HTMLButtonElement>('[data-ton-schalter]');

      if (klang && schalter.length) {
        const SCHLUESSEL = 'flexibelle-ton';

        /** Lautstärke der Hintergrundmusik: 0 = stumm, 1 = volle Lautstärke.
         *  Bewusst gedämpft — sie soll unter der Seite liegen, nicht davor.
         *  Hinweis: iPhone und iPad ignorieren diesen Wert, dort regelt das
         *  Gerät die Lautstärke. */
        const LAUTSTAERKE = 0.4;

        /** Der Song beginnt mit Vorlauf; wir setzen bei Sekunde 10 ein.
         *  Gilt auch für die Schlaufe — deshalb kein loop-Attribut, sondern
         *  der ended-Fall weiter unten. */
        const START = 10;

        /** Ein- und Ausblenden in Millisekunden. Ein harter Einsatz erschrickt,
         *  ein hartes Ende reisst ab. */
        const EINBLENDEN = 2500;
        const AUSBLENDEN = 700;

        klang.volume = 0;

        // Läuft gerade eine Blende? Dann die alte abbrechen, sonst kämpfen zwei
        // Blenden um dieselbe Lautstärke.
        let blende: ReturnType<typeof setInterval> | null = null;

        /**
         * Bewusst mit setInterval statt requestAnimationFrame: rAF steht still,
         * sobald der Tab in den Hintergrund geht — die Musik liefe dann stumm
         * weiter, weil die Blende nie fertig würde. Timer laufen weiter.
         */
        function blenden(ziel: number, dauer: number, danach?: () => void) {
          if (blende) clearInterval(blende);
          const von = klang!.volume;
          const t0 = Date.now();
          blende = setInterval(() => {
            const anteil = Math.min(1, (Date.now() - t0) / dauer);
            klang!.volume = Math.max(0, Math.min(1, von + (ziel - von) * anteil));
            if (anteil >= 1) {
              clearInterval(blende!);
              blende = null;
              danach?.();
            }
          }, 40);
        }

        function starten() {
          if (klang!.currentTime < START) klang!.currentTime = START;
          klang!.volume = 0;
          klang!.play().then(() => blenden(LAUTSTAERKE, EINBLENDEN)).catch(() => zeigen(false));
        }

        function stoppen() {
          zeigen(false);
          blenden(0, AUSBLENDEN, () => klang!.pause());
        }

        function zeigen(laeuft: boolean) {
          for (const knopf of schalter) {
            knopf.setAttribute('aria-pressed', String(laeuft));
            knopf.setAttribute('aria-label', laeuft ? 'Musik anhalten' : 'Musik abspielen');
            knopf.querySelector('[data-ton-aus]')?.classList.toggle('hidden', laeuft);
            knopf.querySelector('[data-ton-an]')?.classList.toggle('hidden', !laeuft);
          }
        }

        for (const knopf of schalter) {
          knopf.addEventListener('click', () => (klang.paused ? starten() : stoppen()));
        }

        // Schlaufe von Hand: wieder ab Sekunde 10, nicht ab null.
        klang.addEventListener('ended', () => {
          klang.currentTime = START;
          klang.play().catch(() => zeigen(false));
        });

        klang.addEventListener('play', () => {
          zeigen(true);
          sessionStorage.setItem(SCHLUESSEL, 'an');
        });
        klang.addEventListener('pause', () => {
          zeigen(false);
          sessionStorage.setItem(SCHLUESSEL, 'aus');
        });
        // Stand über Impressum und Datenschutz hinweg merken.
        klang.addEventListener('timeupdate', () => {
          sessionStorage.setItem(SCHLUESSEL + '-stelle', String(klang.currentTime));
        });

        if (sessionStorage.getItem(SCHLUESSEL) === 'an') {
          const stelle = Number(sessionStorage.getItem(SCHLUESSEL + '-stelle') ?? 0);
          klang.currentTime = stelle > START ? stelle : START;
          // Kann der Browser ablehnen — dann bleibt der Knopf einfach auf «aus».
          klang.play().then(() => blenden(LAUTSTAERKE, EINBLENDEN)).catch(() => zeigen(false));
        }

        // Ton anhalten, wenn eine Hörprobe gestartet wird — sonst spielt beides.
        for (const spieler of document.querySelectorAll('video')) {
          spieler.addEventListener('play', () => { if (!klang.paused) stoppen(); });
        }
      }
    </script>
  </body>
</html>
