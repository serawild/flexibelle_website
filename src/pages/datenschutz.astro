---
import Basis from '../layouts/Basis.astro';
import Abschnitt from '../components/Abschnitt.astro';
---

<Basis titel="Datenschutz — flexiBelle" beschreibung="Datenschutzerklärung der Website flexibelle.live">
  <Abschnitt label="Rechtliches" titel="Datenschutz">
    <div class="mt-8 max-w-text space-y-5">
      <p>
        Diese Website setzt keine Cookies, bindet keine Werbung ein und verwendet keine
        Analysewerkzeuge. Es werden keine Konten angelegt und keine Formulardaten erhoben.
      </p>
      <p>
        Beim Aufruf der Seite überträgt dein Browser technisch notwendige Angaben an unseren
        Hoster (GitHub Pages), darunter IP-Adresse, Zeitpunkt und aufgerufene Seite. Diese
        Angaben verarbeitet GitHub zur Auslieferung der Seite.
      </p>
      <p>
        Die Videos im Abschnitt Musik werden erst geladen, wenn du sie abspielst, und
        stammen von YouTube im Modus ohne Cookies (<span class="font-mono text-[0.9em]">youtube-nocookie.com</span>).
        Dabei gelten die Datenschutzbestimmungen von Google.
      </p>
      <p>
        Schreibst du uns eine Mail, verwenden wir deine Angaben ausschliesslich für die
        Beantwortung deiner Anfrage.
      </p>
    </div>
  </Abschnitt>
</Basis>
