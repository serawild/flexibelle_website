---
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Knopf from '../components/Knopf.astro';
import Besetzung from '../components/Besetzung.astro';
import TerminListe from '../components/TerminListe.astro';
import musik from '../data/musik.json';
import presse from '../data/presse.json';
import { existsSync, statSync, readFileSync } from 'node:fs';

// Musik-Abschnitt: alle Hörproben sind gleich grosse Kacheln, drei pro Zeile.
// Gruppiert nach `ort` aus musik.json — eine Zeile je Auftrittsort, in der
// Reihenfolge, in der die Orte dort zum ersten Mal vorkommen.
const orte: string[] = [];
for (const s of musik) if (!orte.includes(s.ort)) orte.push(s.ort);
const reihen = orte.map((ort) => ({ ort, proben: musik.filter((s) => s.ort === ort) }));

/**
 * Presse: je Format eine Fassung in voller Auflösung und eine fürs Web.
 * Masse und Dateigrösse werden beim Bauen aus der Datei selbst gelesen — so
 * stimmen die Angaben auch, wenn ein Bild später ausgetauscht wird.
 * Angeboten wird nur, was wirklich in public/presse/ liegt; fehlt eine Datei,
 * entsteht kein toter Link.
 */
function jpegMasse(pfad: string): string {
  const d = readFileSync(pfad);
  let i = 2;
  while (i < d.length) {
    if (d[i] !== 0xff) { i++; continue; }
    const marker = d[i + 1];
    // SOF0–SOF15, ohne die Marker ohne Bildmasse (C4 = DHT, C8, CC = DAC)
    if (marker >= 0xc0 && marker <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marker)) {
      return `${d.readUInt16BE(i + 7)} × ${d.readUInt16BE(i + 5)} px`;
    }
    i += 2 + d.readUInt16BE(i + 2);
  }
  return '';
}

function fassung(datei?: string) {
  if (!datei) return null;
  const pfad = `public${datei}`;
  if (!existsSync(pfad)) return null;
  const mb = statSync(pfad).size / 1048576;
  return { datei, masse: jpegMasse(pfad), groesse: `${mb.toFixed(1)} MB` };
}

const presseBilder = presse.bilder
  .map((b) => ({ label: b.label, hinweis: b.hinweis, voll: fassung(b.voll), web: fassung(b.web) }))
  .filter((b) => b.voll || b.web);
---

<Basis
  titel="flexiBelle — Live Musik & eigeni Songs"
  beschreibung="Live Musik und eigeni Songs. Es Trio — und je nach Song eis meh. Komplett ausgerüstet mit eigener PA. Anfragen für Feste, Bars und Hochzeiten.">

  <Hero />

  <!-- ================= Band ================= -->
  <Abschnitt id="band" label="Die Band" titel="Zu dritt — und manchmal zu viert">
    <div class="mt-6 max-w-text space-y-5">
      <p>
        Bassgitarre, akustische Gitarre und Ukulele, E-Piano und Gesang: das ist der Kern.
        Für einzelne Songs holen wir jemanden dazu — eine Geige, ein Saxofon, oder etwas ganz neues.
        Wer das ist, entscheidet der Abend. Deshalb heissen wir, wie wir heissen.
      </p>
      <p>
        Da proben wir: rustikale Scheune, Holzboden, alte Balken und DIY-Vibe. Hier entstehen die Songs,
        und hier klingen sie zum ersten Mal.
      </p>
    </div>

    <Besetzung />
  </Abschnitt>

  <!-- ================= Zitat ================= -->
  <section class="bg-khaki-hell px-6 py-20 text-center sm:px-10">
    <blockquote class="mx-auto max-w-3xl font-zitat text-zitat italic text-khaki-tief text-pretty">
      «Als Jäger und Sammler vo schöne Melodie und Gschichte triibts euis immer wieder id
      Schüüne, wo die rohe Songs zwäg gflext wärded. Mit Liideschaft und stets bemüeht, die
      richtige Saite &amp; Taste z'träffe, gömmer druf los und luege was passiert.»
    </blockquote>
  </section>

  <!-- ================= Musik ================= -->
  <Abschnitt id="musik" label="Musik" titel="Unser Stil">
    <p class="mt-6 max-w-text">
      Eigene Songs, dazu Lieder, die wir unterwegs gesammelt haben. Am besten hörst du selbst rein.
    </p>

    {reihen.map((reihe) => (
      <div class="mt-10">
        <p class="label text-ocker-text">{reihe.ort}</p>

        <div class="mt-4 grid items-stretch gap-6 grid-cols-1 sm:grid-cols-3">
          {reihe.proben.map((s) => (
            <figure class="flex h-full flex-col border border-sand bg-karte p-4">
              <div class="aspect-video w-full bg-sand">
                {s.datei ? (
                  <video
                    class="h-full w-full object-cover"
                    src={s.datei}
                    poster={s.bild}
                    controls
                    playsinline
                    preload="none"></video>
                ) : s.id ? (
                  <iframe
                    class="h-full w-full"
                    src={`https://www.youtube-nocookie.com/embed/${s.id}`}
                    title={s.titel}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                    allowfullscreen></iframe>
                ) : s.bild ? (
                  <img src={s.bild} alt={s.titel} class="h-full w-full object-cover" />
                ) : null}
              </div>
              <figcaption class="mt-3">
                <p class="titel text-untertitel">{s.titel}</p>
                {s.notiz && <p class="mt-1 text-sm text-taupe">{s.notiz}</p>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}

  </Abschnitt>

  <!-- ================= Live ================= -->
  <Abschnitt id="live" label="Live" titel="Unsere nächsten Gigs" class="bg-karte">
    <TerminListe />
    <p class="mt-6 text-taupe">
      Steht bei einem Termin ein Name, spielt an dem Abend jemand mit uns. Steht nichts da, sind wir zu dritt.
    </p>
  </Abschnitt>

  <!-- ================= Booking ================= -->
  <Abschnitt id="booking" label="Booking" titel="Wir kommen so oder so" dunkel>
    <p class="mt-6 max-w-text text-taupe-hell">
      Wir haben eine eigene Anlage dabei — können aber auch über eure spielen. Was besser
      passt, entscheidet ihr.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- Variante 1: eigene PA -->
      <div class="border border-ocker/40 bg-braun-weich/40 p-8">
        <p class="label text-ocker">Variante 1</p>
        <h3 class="titel mt-3 text-untertitel">Mit unserer Anlage</h3>
        <p class="mt-4 text-taupe-hell">
          Eigene PA, eigenes Mischpult, Mikrofone und Monitoring. Barhocker und
          Bassverstärker bringen wir auch selbst. Ihr müsst nichts organisieren und nichts mieten.
        </p>
        <p class="label mt-6 text-ocker">Von euch brauchen wir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">2× Strom 230 V an der Bühne</li>
          <li class="border-b border-braun-weich pb-2">Ca. 3 × 2 Meter Platz</li>
          <li class="border-b border-braun-weich pb-2">Zugang zum Abladen in der Nähe</li>
          <li class="border-b border-braun-weich pb-2">Ca. eine Stunde Zeit zum Aufbauen</li>
        </ul>
      </div>

      <!-- Variante 2: PA vor Ort -->
      <div class="border border-khaki/50 bg-braun-weich/40 p-8">
        <p class="label text-khaki-hell">Variante 2</p>
        <h3 class="titel mt-3 text-untertitel">Über eure Anlage</h3>
        <p class="mt-4 text-taupe-hell">
          Wenn schon eine Anlage steht oder ein Tontechniker dabei ist, spielen wir gern
          darüber. Wir bringen unsere Instrumente, unsere Mikrofone und den Bassverstärker mit.
        </p>
        <p class="label mt-6 text-khaki-hell">Von euch brauchen wir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">Mischpult mit mindestens 7 Kanälen</li>
          <li class="border-b border-braun-weich pb-2">
            2× Mikrofonständer — die Mikrofone bringen wir selbst mit, sie brauchen Phantomspeisung
          </li>
          <li class="border-b border-braun-weich pb-2">
            1× DI-Box für die Ukulele — die Gitarre hat eine eingebaute, dort reicht ein Jack-Kabel
          </li>
          <li class="border-b border-braun-weich pb-2">
            Monitore optional — sonst hängen wir unser In-Ear-Monitoring an
          </li>
          <li class="border-b border-braun-weich pb-2">2× Strom 230 V an der Bühne</li>
        </ul>
      </div>
    </div>

    <p class="mt-6 text-label uppercase text-taupe-hell">
      Zuhause im Aareland &amp; Fricktal
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <Knopf href="mailto:info@serawild.com?subject=Anfrage%20flexiBelle">
        Anfrage senden
      </Knopf>
      <Knopf href="tel:+41797905701" art="rand">+41 79 790 57 01</Knopf>
      <Knopf href="/flexiBelle_TechRider.pdf" art="rand">Tech Rider als PDF</Knopf>
    </div>
    <p class="mt-4 text-taupe-hell">
      Für eine Anfrage reicht eine kurze Mail oder ein Anruf mit Datum, Ort und Anlass.
    </p>

    <!-- Presse: eingeklappt, weil es nur Veranstalter und Medien betrifft.
         <details> kommt ohne JavaScript aus und ist mit Tastatur bedienbar. -->
    <details class="group mt-12 border-t border-braun-weich pt-8">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
        <span>
          <span class="label text-ocker">Presse</span>
          <span class="titel mt-3 block text-untertitel">Text und Bilder zum Übernehmen</span>
          <span class="mt-2 block text-taupe-hell">Für Veranstalter und Medien</span>
        </span>
        <svg
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          aria-hidden="true"
          class="h-6 w-6 shrink-0 text-ocker transition-transform duration-200 group-open:rotate-180">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </summary>

      <p class="mt-8 max-w-text text-taupe-hell">{presse.text}</p>
      <blockquote class="mt-4 max-w-text border-l-2 border-ocker/50 pl-4 font-zitat italic text-taupe-hell">
        «{presse.zitat}»
      </blockquote>

      <div class="mt-6">
        <Knopf href={presse.pdf} art="rand" download>Pressetext als PDF</Knopf>
      </div>

      {presseBilder.length > 0 && (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {presseBilder.map((b) => (
            <div>
              <p class="label text-khaki-hell">{b.label}</p>
              {b.hinweis && <p class="mt-1 text-sm text-taupe-hell/70">{b.hinweis}</p>}
              <div class="mt-3 flex flex-col gap-2">
                {b.voll && (
                  <a href={b.voll.datei} download class="border border-khaki px-4 py-3 text-khaki-hell transition-colors hover:bg-khaki hover:text-beige">
                    <span class="block text-label font-semibold uppercase">Volle Auflösung</span>
                    <span class="mt-1 block text-sm opacity-80">{b.voll.masse} · {b.voll.groesse}</span>
                  </a>
                )}
                {b.web && (
                  <a href={b.web.datei} download class="border border-braun-weich px-4 py-3 text-taupe-hell transition-colors hover:border-khaki hover:text-khaki-hell">
                    <span class="block text-label font-semibold uppercase">Fürs Web</span>
                    <span class="mt-1 block text-sm opacity-80">{b.web.masse} · {b.web.groesse}</span>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      <p class="mt-4 text-taupe-hell">
        Foto: <a href={presse.fotografLink} class="underline underline-offset-4 hover:text-ocker" target="_blank" rel="noopener noreferrer">{presse.fotograf}</a>. {presse.nutzung}
      </p>
    </details>
  </Abschnitt>
</Basis>
