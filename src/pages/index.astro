---
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Knopf from '../components/Knopf.astro';
import Besetzung from '../components/Besetzung.astro';
import TerminListe from '../components/TerminListe.astro';
import musik from '../data/musik.json';
---

<Basis
  titel="flexiBelle — Live Musik & eigeni Songs"
  beschreibung="Trio für Live Musik und eigeni Songs — und je nach Song eines mehr. Komplett ausgerüstet mit eigener PA. Anfragen für Feste, Bars und Hochzeiten.">

  <Hero />

  <!-- ================= Band ================= -->
  <Abschnitt id="band" label="Die Band" titel="Zu dritt — und manchmal zu viert">
    <div class="mt-6 max-w-text space-y-5">
      <p>
        Bassgitarre, akustische Gitarre und Ukulele, E-Piano und Gesang: das ist der Kern.
        Für einzelne Songs holen wir jemanden dazu — eine Geige, ein Saxofon, oder etwas ganz neues.
        Wer das ist, entscheidet der Abend. Deshalb heissen wir, wie wir heissen.
      </p>
      <p>
        Da proben wir: rustikale Scheune, Holzboden, alte Balken und DIY-Vibe. Hier entstehen die Songs,
        und hier klingen sie zum ersten Mal.
      </p>
    </div>

    <Besetzung />
  </Abschnitt>

  <!-- ================= Zitat ================= -->
  <section class="bg-khaki-hell px-6 py-20 text-center sm:px-10">
    <blockquote class="mx-auto max-w-3xl font-zitat text-zitat italic text-khaki-tief text-pretty">
      «Als Jäger und Sammler vo schöne Melodie und Gschichte triibts euis immer wieder id
      Scheune, wo die rohe Songs zwäg gflext wärded. Mit Liideschaft und stets bemüeht, die
      richtige Saite &amp; Taste z'träffe, gömmer druf los und luege was passiert.»
    </blockquote>
  </section>

  <!-- ================= Musik ================= -->
  <Abschnitt id="musik" label="Musik" titel="Unser Stil">
    <p class="mt-6 max-w-text">
      Eigene Songs, dazu Lieder, die wir unterwegs gesammelt haben. Am besten hörst du selbst rein.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {musik.map((s) => (
        <figure class="border border-sand bg-karte p-6">
          <div class="aspect-video w-full bg-sand">
            {s.datei ? (
              <video
                class="h-full w-full object-cover"
                src={s.datei}
                poster={s.bild}
                controls
                playsinline
                preload="none"></video>
            ) : s.id ? (
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${s.id}`}
                title={s.titel}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen></iframe>
            ) : s.bild ? (
              <img src={s.bild} alt={s.titel} class="h-full w-full object-cover" />
            ) : null}
          </div>
          <figcaption class="mt-4">
            <p class="titel text-untertitel">{s.titel}</p>
            <p class="mt-1 text-taupe">{s.notiz}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </Abschnitt>

  <!-- ================= Live ================= -->
  <Abschnitt id="live" label="Live" titel="Unsere nächsten Gigs" class="bg-karte">
    <TerminListe />
    <p class="mt-6 text-taupe">
      Steht bei einem Termin ein Name, spielt an dem Abend jemand mit uns. Steht nichts da, sind wir zu dritt.
    </p>
  </Abschnitt>

  <!-- ================= Booking ================= -->
  <Abschnitt id="booking" label="Booking" titel="Wir kommen so oder so" dunkel>
    <p class="mt-6 max-w-text text-taupe-hell">
      Wir haben eine eigene Anlage dabei — können aber auch über eure spielen. Was besser
      passt, entscheidet ihr.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- Variante 1: eigene PA -->
      <div class="border border-ocker/40 bg-braun-weich/40 p-8">
        <p class="label text-ocker">Variante 1</p>
        <h3 class="titel mt-3 text-untertitel">Mit unserer Anlage</h3>
        <p class="mt-4 text-taupe-hell">
          Eigene PA, eigenes Mischpult, Mikrofone und Monitoring. Barhocker und
          Bassverstärker bringen wir auch selbst. Ihr müsst nichts organisieren und nichts mieten.
        </p>
        <p class="label mt-6 text-ocker">Von euch brauchen wir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">2× Strom 230 V an der Bühne</li>
          <li class="border-b border-braun-weich pb-2">Ca. 3 × 2 Meter Platz</li>
          <li class="border-b border-braun-weich pb-2">Zugang zum Abladen in der Nähe</li>
          <li class="border-b border-braun-weich pb-2">Ca. eine Stunde Zeit zum Aufbauen</li>
        </ul>
      </div>

      <!-- Variante 2: PA vor Ort -->
      <div class="border border-khaki/50 bg-braun-weich/40 p-8">
        <p class="label text-khaki-hell">Variante 2</p>
        <h3 class="titel mt-3 text-untertitel">Über eure Anlage</h3>
        <p class="mt-4 text-taupe-hell">
          Wenn schon eine Anlage steht oder ein Tontechniker dabei ist, spielen wir gern
          darüber. Wir bringen unsere Instrumente und den Bassverstärker mit.
        </p>
        <p class="label mt-6 text-khaki-hell">Von euch brauchen wir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">Mischpult mit mindestens 7 Kanälen</li>
          <li class="border-b border-braun-weich pb-2">2× DI-Box (akustische Gitarre, Ukulele)</li>
          <li class="border-b border-braun-weich pb-2">2× Mikrofon inklusive Ständer</li>
          <li class="border-b border-braun-weich pb-2">2 Monitore und 2× Strom 230 V</li>
        </ul>
      </div>
    </div>

    <p class="mt-6 text-label uppercase text-taupe-hell">
      Zuhause im Aareland &amp; Fricktal
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <Knopf href="mailto:info@serawild.com?subject=Anfrage%20flexiBelle">
        Anfrage senden
      </Knopf>
      <Knopf href="tel:+41797905701" art="rand">+41 79 790 57 01</Knopf>
      <Knopf href="/flexiBelle_TechRider.pdf" art="rand">Tech Rider als PDF</Knopf>
    </div>
    <p class="mt-4 text-taupe-hell">
      Für eine Anfrage reicht eine kurze Mail oder ein Anruf mit Datum, Ort und Anlass.
    </p>
  </Abschnitt>
</Basis>
