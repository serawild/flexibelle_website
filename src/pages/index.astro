---
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Knopf from '../components/Knopf.astro';
import Besetzung from '../components/Besetzung.astro';
import TerminListe from '../components/TerminListe.astro';
import musik from '../data/musik.json';
---

<Basis
  titel="flexiBelle — Live Musik & eigeni Songs"
  beschreibung="Trio für Live Musik und eigene Songs — und je nach Song eins mehr. Komplett ausgerüstet mit eigener PA. Anfragen für Feste, Beizen und Hochzeiten.">

  <Hero />

  <!-- ================= Band ================= -->
  <Abschnitt id="band" label="D’Band" titel="Zu dritt — und mängisch zu viert">
    <div class="mt-6 max-w-text space-y-5">
      <p>
        Bassgitarre, akustischi Gitarre und Ukulele, E-Piano und Gsang: das isch de Kern.
        Für einzelni Songs hole mir öpper dezue — e Gigen, es Saxofon, e zweiti Stimm.
        Wer das isch, entscheidet de Abig. Drum heisse mir, wie mir heisse.
      </p>
      <p>
        Schüüre: rustikale Scheune, Holzbode, alti Balke und DIY-Vibe. Hie entstönd d’Songs,
        und hie tönd si zum erste Mal.
      </p>
    </div>

    <Besetzung />
  </Abschnitt>

  <!-- ================= Zitat ================= -->
  <section class="bg-khaki-hell px-6 py-20 text-center sm:px-10">
    <blockquote class="mx-auto max-w-3xl font-zitat text-zitat italic text-khaki-tief text-pretty">
      «Als Jäger und Sammler vo schöne Melodie und Gschichte triibts euis immer wieder id
      Schüüne, wo die rohe Songs zwäg gflext wärded. Mit Liideschaft und stets bemüeht, die
      richtige Saite &amp; Taste z’träffe, gömmer druf los und luege was passiert.»
    </blockquote>
  </section>

  <!-- ================= Musik ================= -->
  <Abschnitt id="musik" label="Musik" titel="Unser Stil">
    <p class="mt-6 max-w-text">
      Eigeni Songs, dezue Lieder, wo mir underwägs zämegsammlet hend. Am beste hörsch
      sälber ine.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {musik.map((s) => (
        <figure class="border border-sand bg-karte p-6">
          <div class="aspect-video w-full bg-sand">
            {s.id && (
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${s.id}`}
                title={s.titel}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen></iframe>
            )}
          </div>
          <figcaption class="mt-4">
            <p class="titel text-untertitel">{s.titel}</p>
            <p class="mt-1 text-taupe">{s.notiz}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </Abschnitt>

  <!-- ================= Live ================= -->
  <Abschnitt id="live" label="Live" titel="Unsere nächsten Gigs" class="bg-karte">
    <TerminListe />
    <p class="mt-6 text-taupe">
      Staht bi eme Termin en Name, spielt an dem Abig öpper mit eus. Staht nüt da, sind mir
      zu dritt.
    </p>
  </Abschnitt>

  <!-- ================= Booking ================= -->
  <Abschnitt id="booking" label="Booking" titel="Mir chömed so oder so" dunkel>
    <p class="mt-6 max-w-text text-taupe-hell">
      Mir hend ei eigeni Alag debi — chönd aber au über eui spiele. Was besser
      passt, entscheided ihr.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- Variante 1: eigene PA -->
      <div class="border border-ocker/40 bg-braun-weich/40 p-8">
        <p class="label text-ocker">Variante 1</p>
        <h3 class="titel mt-3 text-untertitel">Mit eusere Alag</h3>
        <p class="mt-4 text-taupe-hell">
          Eigeni PA, eigets Mischpult, Mikrofone und Monitoring. Barhocker und
          Bassverstärker bringed mir au sälber. Ihr müend nüt organisiere und nüt miete.
        </p>
        <p class="label mt-6 text-ocker">Vo eu bruuched mir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">2× Strom 230 V a de Bühni</li>
          <li class="border-b border-braun-weich pb-2">Öppe 3 × 2 Meter Platz</li>
          <li class="border-b border-braun-weich pb-2">Zuegang zum Abelade i de Nöchi</li>
          <li class="border-b border-braun-weich pb-2">Öppe e Stund Ziit zum Ufbaue</li>
        </ul>
      </div>

      <!-- Variante 2: PA vor Ort -->
      <div class="border border-khaki/50 bg-braun-weich/40 p-8">
        <p class="label text-khaki-hell">Variante 2</p>
        <h3 class="titel mt-3 text-untertitel">Über eui Alag</h3>
        <p class="mt-4 text-taupe-hell">
          Wenn scho e Alag staht oder en Tontechniker debi isch, spieled mir gärn
          drüber. Mir bringed eusi Instrument und de Bassverstärker mit.
        </p>
        <p class="label mt-6 text-khaki-hell">Vo eu bruuched mir</p>
        <ul class="mt-3 space-y-2 text-taupe-hell">
          <li class="border-b border-braun-weich pb-2">Mischpult mit mindeschtens 7 Kanäl</li>
          <li class="border-b border-braun-weich pb-2">2× DI-Box (akustischi Gitarre, Ukulele)</li>
          <li class="border-b border-braun-weich pb-2">2× Mikrofon inklusiv Ständer</li>
          <li class="border-b border-braun-weich pb-2">2 Monitore und 2× Strom 230 V</li>
        </ul>
      </div>
    </div>

    <p class="mt-6 text-label uppercase text-taupe-hell">
      Zuhause im Aareland &amp; Fricktal
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <Knopf href="mailto:info@serawild.com?subject=Aafrag%20flexiBelle">
        Aafrag schicke
      </Knopf>
      <Knopf href="tel:+41797905701" art="rand">+41 79 790 57 01</Knopf>
      <Knopf href="/flexiBelle_TechRider.pdf" art="rand">Tech Rider als PDF</Knopf>
    </div>
    <p class="mt-4 text-taupe-hell">
      Für e Aafrag längt e churzi Mail oder Anruf mit Datum, Ort und Aalass.
    </p>
  </Abschnitt>
</Basis>
